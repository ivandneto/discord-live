{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Ponte",
  "version": "0.2.0",
  "identifier": "com.liveponte.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Live Ponte",
        "width": 400,
        "height": 600,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Live Ponte",
    "shortDescription": "Abre o Discord por uma saída estrangeira",
    "longDescription": "Abre o Discord por uma saída estrangeira escolhida por você, para a sessão nascer fora do Brasil, e depois volta à conexão direta.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
